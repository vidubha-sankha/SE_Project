eports (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    image_filename VARCHAR(255) NOT NULL,
    image_path VARCHAR(500) NOT NULL,
    latitude FLOAT NOT NULL,
    longitude FLOAT NOT NULL,
    location_name VARCHAR(500),
    prediction_class VARCHAR(50) NOT NULL,
    confidence_score FLOAT NOT NULL,
    severity VARCHAR(50),
    damage_type VARCHAR(100),
    description TEXT,
    reported_by VARCHAR(100),
    status VARCHAR(50) DEFAULT 'pending',
    priority VARCHAR(50),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_status ON road_damage_reports(status);
CREATE INDEX IF NOT EXISTS idx_severity ON road_damage_reports(severity);
CREATE INDEX IF NOT EXISTS idx_prediction ON road_damage_reports(prediction_class);
CREATE INDEX IF NOT EXISTS idx_created_at ON road_damage_reports(created_at DESC);


